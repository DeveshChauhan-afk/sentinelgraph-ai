# ==============================================================================
# SentinelGraph AI - Frontend Environment Configuration Template
# ==============================================================================
# In development (via npm run dev) and standard containerized deployments
# (Nginx reverse-proxy), API requests default to relative paths (/api, /health, /metrics)
# and are forwarded to the backend without cross-origin configuration.
#
# If the frontend is hosted on a separate domain or CDN from the API, set the
# absolute backend URL below (e.g., https://api.sentinelgraph.example.com).
# Leave empty or omitted for same-origin reverse-proxy deployments.
# ==============================================================================

VITE_API_URL=
