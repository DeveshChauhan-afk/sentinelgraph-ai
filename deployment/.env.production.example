# ==============================================================================
# SentinelGraph AI - Production Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root on your production host:
#   cp deployment/.env.production.example .env
#
# Replace all placeholder values below with strong, unique secrets.
# NEVER commit the real '.env' file or production secrets to version control.
# ==============================================================================

# ==============================================================================
# 1. Security & Application Secrets (MANDATORY)
# ==============================================================================
# Generate a cryptographically secure key: openssl rand -hex 32
SECRET_KEY=generate_strong_random_secret_with_openssl_rand_hex_32

# Production operational toggles
DEBUG=false
LOG_LEVEL=INFO
LOG_TO_FILE=false

# Allowed Cross-Origin Resource Sharing origins.
# In production with Nginx same-origin reverse proxying, API requests are same-origin.
# If accessing through a custom domain or staging preview, specify origins here:
CORS_ORIGINS=http://localhost,https://yourdomain.com

# ==============================================================================
# 2. Google Gemini AI Engine (MANDATORY)
# ==============================================================================
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_production_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ==============================================================================
# 3. PostgreSQL Database (Transactional System of Record)
# ==============================================================================
# In Docker Compose, DATABASE_HOST points to the companion 'postgres' container.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=sentinel_db
DATABASE_USER=sentinel_user
# Generate a strong password: openssl rand -base64 24
DATABASE_PASSWORD=generate_strong_postgres_password_here

# Connection pool tuning (conservative for 2 OCPU / 12 GB RAM VM)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ==============================================================================
# 4. Neo4j Graph Database (Fraud Intelligence Knowledge Graph)
# ==============================================================================
# In Docker Compose, NEO4J_URI points to the companion 'neo4j' container.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
# Generate a strong password: openssl rand -base64 24
NEO4J_PASSWORD=generate_strong_neo4j_password_here
NEO4J_DATABASE=neo4j

# ==============================================================================
# 5. Monitoring & Operational Dashboards (Grafana / Prometheus)
# ==============================================================================
GRAFANA_ADMIN_USER=admin
# Generate a strong password for Grafana web console access
GRAFANA_ADMIN_PASSWORD=generate_strong_grafana_admin_password_here

# ==============================================================================
# 6. Automated Schema Migrations
# ==============================================================================
# Set to true so container entrypoint runs 'alembic upgrade head' before serving
RUN_MIGRATIONS=true
